{
  "name": "nodeai2",
  "version": "1.0.0",
  "description": "Formation Node.js + LLM local avec Ollama et Fastify",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "tsx --watch src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start:dist": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.0",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
